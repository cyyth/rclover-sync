[Desktop Entry]
Name=rclover
Comment=Mount cloud drives on demand and keep chosen folders offline
Exec=rclover
Icon=io.github.cyythanapong_netizen.Rclover
Terminal=false
Type=Application
Categories=GTK;GNOME;Utility;FileTools;
Keywords=cloud;drive;rclone;sync;mount;
DBusActivatable=true
StartupNotify=true
